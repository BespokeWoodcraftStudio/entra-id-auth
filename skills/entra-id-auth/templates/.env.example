# Sign-in settings. Names only; real values live in Vercel (production,
# preview) and in .env.local (this machine), never in git.
# Written by the entra-id-auth skill: see references/secrets-and-settings.md.

DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=
NEXT_PUBLIC_APP_URL=http://localhost:3000

MICROSOFT_ENTRA_TENANT_ID=
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
MICROSOFT_ENTRA_CLIENT_SECRET_EXPIRES=

ALLOW_PASSWORD_SIGNIN=false
CRON_SECRET=

# Only when the site reads Microsoft 365 on the server, with its own app.
M365_READER_TENANT_ID=
M365_READER_CLIENT_ID=
M365_READER_CERTIFICATE_PEM=
M365_READER_CERTIFICATE_EXPIRES=
M365_READER_MAILBOXES=
