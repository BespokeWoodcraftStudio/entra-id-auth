#!/usr/bin/env bash
# Fake Azure CLI for tests/scripts/run.sh. It never calls Microsoft: every
# call is logged to $AZ_STUB_LOG and answered with canned, made-up data
# chosen by the call's arguments. With STUB_FORBID_WRITES=1 a write verb is
# logged as WRITE-ATTEMPT and refused (exit 97), so a plan that tried to
# change a tenant fails loudly.
#
# Knobs (environment):
#   AZ_STUB_P1       yes | no | unknown   Entra ID P1 in the licences (default yes)
#   AZ_STUB_SECDEF   on | off             security defaults (default off)
#   AZ_STUB_GROUP    none | ours | foreign  a group with the site's name exists (default none)
#   AZ_STUB_ROLES    the signed-in admin's directory roles, one per line
#   AZ_STUB_DOMAINS  custom | onmicrosoft  the tenant has a custom domain (default custom)
#   AZ_STUB_CA       none | sign-in-only | both  the site's MFA policy and the groups it
#                    names (default none: no policy)
#   AZ_STUB_MEMBERS_DIR  a folder holding one file per group, named by the group's id:
#                    one user a line, "<id> <enabled> <userType> <mail> <name>" (tabs).
#                    A line "!fail" makes the page holding it unreadable. A group with
#                    no file has no members (the default for every group).
#   AZ_STUB_PAGE_SIZE    users per page for those groups (default 999); the next page
#                    is offered through @odata.nextLink, as Graph does.
#   AZ_STUB_NEXTLINK_FAIL  1: every read of a group page's "@odata.nextLink" fails
#                    (a throttle on that one read), while the rows still read.
#   AZ_STUB_APP_FOUND  yes: "ad app show --query id" finds the app (default: not found).
#   AZ_STUB_GUEST_READ_FAIL  1: only the guest-filtered group read (userType=='Guest')
#                    fails (a throttle on that one read); every other read works.
#   AZ_STUB_SHAPE_DIR  a folder holding one file per group, named by the group's id,
#                    with any of these lines (a group with no file is a clean
#                    static security group with no nested groups):
#                      shape <securityEnabled> <mailEnabled> <number of groupTypes>
#                      shape fail     the type read fails (a throttle on that read)
#                      nested <n>     the group holds <n> nested groups
#                      nested fail    the nested-group read fails
# A group page asked for "value[].[accountEnabled, userType, ...]" (preflight --group)
# answers every row, disabled and guests too, as enabled<TAB>type<TAB>address.
# Addresses starting with missing, guest or disabled resolve that way.
set -euo pipefail

ARGS="$*"
[ -z "${AZ_STUB_LOG:-}" ] || printf 'az %s\n' "$ARGS" >> "$AZ_STUB_LOG"

TENANT="00000000-0000-0000-0000-000000000000"
P1="${AZ_STUB_P1:-yes}"; SECDEF="${AZ_STUB_SECDEF:-off}"; GROUP="${AZ_STUB_GROUP:-none}"
ROLES="${AZ_STUB_ROLES:-Groups Administrator
Application Developer}"

# fake_id <text>: a made-up GUID derived from the text (same text, same id).
fake_id() {
  local n
  n="$(printf '%s' "$1" | cksum | cut -d' ' -f1)"
  printf '%08x-0000-4000-8000-%012d\n' "$n" "$n"
}

# query: the value after --query, if any.
query() {
  local prev="" a
  for a in "$@"; do
    [ "$prev" = "--query" ] && { printf '%s' "$a"; return 0; }
    prev="$a"
  done
}
# arg_after <flag>: the value after a flag.
arg_after() {
  local want="$1" prev="" a; shift
  for a in "$@"; do
    [ "$prev" = "$want" ] && { printf '%s' "$a"; return 0; }
    prev="$a"
  done
}
Q="$(query "$@")"
TSV=no; case "$ARGS" in *"-o tsv"*) TSV=yes ;; esac
METHOD="$(arg_after --method "$@" | tr '[:upper:]' '[:lower:]')"
URL="$(arg_after --url "$@")"

is_write() {
  case "$ARGS" in
    "login"*|"logout"*) return 0 ;;
    "ad group create"*|"ad group update"*|"ad group delete"*) return 0 ;;
    "ad group member add"*|"ad group member remove"*|"ad group owner add"*|"ad group owner remove"*) return 0 ;;
    "ad app create"*|"ad app update"*|"ad app delete"*) return 0 ;;
    "ad app owner add"*|"ad app owner remove"*|"ad app credential reset"*|"ad app credential delete"*) return 0 ;;
    "ad app permission"*) return 0 ;;
    "ad sp create"*|"ad sp update"*|"ad sp delete"*|"ad sp owner"*) return 0 ;;
    "rest"*) case "$METHOD" in post|patch|put|delete) return 0 ;; esac ;;
  esac
  return 1
}
if is_write; then
  [ -z "${AZ_STUB_LOG:-}" ] || printf 'WRITE-ATTEMPT az %s\n' "$ARGS" >> "$AZ_STUB_LOG"
  if [ "${STUB_FORBID_WRITES:-0}" = 1 ]; then echo "az stub: refused a write in a test" >&2; exit 97; fi
  exit 0
fi

empty() { if [ "$TSV" = yes ]; then :; else printf '[]\n'; fi; }
# shape_line <group id> <shape|nested>: the rest of that line in the group's
# AZ_STUB_SHAPE_DIR file, or nothing.
shape_line() {
  local f="${AZ_STUB_SHAPE_DIR:-/nonexistent}/$1"
  [ -f "$f" ] || return 0
  awk -v k="$2" '$1 == k { $1 = ""; sub(/^ /, ""); print; exit }' "$f"
}

case "$ARGS" in
  "account show"*)
    case "$Q" in
      tenantId) printf '%s\n' "$TENANT" ;;
      *) printf '%s\tadmin@contoso.com\tuser\n' "$TENANT" ;;
    esac ;;
  "ad user show"*)
    id="$(arg_after --id "$@")"
    case "$id" in missing*) echo "ERROR: Resource '$id' does not exist." >&2; exit 3 ;; esac
    enabled=true; utype=Member
    case "$id" in guest*) utype=Guest ;; disabled*) enabled=false ;; esac
    case "$Q" in
      id) fake_id "$id" ;;
      *) printf '%s\t%s\t%s\t%s\n' "$(fake_id "$id")" "$enabled" "$utype" "Test Person" ;;
    esac ;;
  "ad sp show"*)
    case "$Q" in id) fake_id "graph-service-principal" ;; *) empty ;; esac ;;
  "ad group list"*)
    case "$GROUP" in none) empty ;; *) fake_id "existing-group" ;; esac ;;
  "ad group show"*)
    case "$Q" in
      description)
        if [ "$GROUP" = ours ]; then printf 'Can open https://portal.contoso.com. Set up by the entra-id-auth skill. entra-id-auth:portal.contoso.com\n'
        else printf 'Another team uses this group.\n'; fi ;;
      displayName) printf 'Contoso Example\n' ;;
      "[securityEnabled"*)
        sh="$(shape_line "$(arg_after --group "$@" | tr '[:upper:]' '[:lower:]')" shape)"
        case "$sh" in
          "") printf 'true\tfalse\t0\n' ;;
          fail) echo "Too Many Requests (429)" >&2; exit 1 ;;
          *) printf '%s\n' "$sh" | tr ' ' '\t' ;;
        esac ;;
      id) fake_id "existing-group" ;;
      *) empty ;;
    esac ;;
  "ad group member check"*)
    gid="$(arg_after --group "$@" | tr '[:upper:]' '[:lower:]')"; mid="$(arg_after --member-id "$@" | tr '[:upper:]' '[:lower:]')"
    f="${AZ_STUB_MEMBERS_DIR:-/nonexistent}/$gid"
    if [ -f "$f" ] && cut -f1 "$f" | tr '[:upper:]' '[:lower:]' | grep -qx "$mid"; then printf 'true\n'; else printf 'false\n'; fi ;;
  "ad app show"*)
    if [ "${AZ_STUB_APP_FOUND:-no}" = yes ] && [ "$Q" = id ]; then fake_id "app-$(arg_after --id "$@")"; else empty; fi ;;
  "ad app list"*|"ad sp list"*|"ad group member list"*|"ad group owner list"*|"ad app owner list"*|"ad app credential list"*)
    empty ;;
  "rest"*)
    case "$URL" in
      *"/organization"*)
        case "$Q" in
          *displayName*) printf 'Contoso\n' ;;
          *isDefault*) if [ "${AZ_STUB_DOMAINS:-custom}" = onmicrosoft ]; then printf 'contoso.onmicrosoft.com\n'; else printf 'contoso.com\n'; fi ;;
          *verifiedDomains*) if [ "${AZ_STUB_DOMAINS:-custom}" = onmicrosoft ]; then printf 'contoso.onmicrosoft.com\n'; else printf 'contoso.com\ncontoso.onmicrosoft.com\n'; fi ;;
          *) empty ;;
        esac ;;
      *"/me/memberOf"*) printf '%s\n' "$ROLES" ;;
      *"/policies/authorizationPolicy"*) printf 'true\n' ;;
      *"/subscribedSkus"*)
        case "$P1" in
          yes) printf 'AAD_PREMIUM\nEXCHANGE_S_STANDARD\n' ;;
          no) printf 'EXCHANGE_S_STANDARD\n' ;;
          *) echo "Forbidden (403)" >&2; exit 1 ;;
        esac ;;
      *"/policies/identitySecurityDefaultsEnforcementPolicy"*)
        if [ "$SECDEF" = on ]; then printf 'true\n'; else printf 'false\n'; fi ;;
      *"/conditionalAccess/policies"*)
        if [ "$SECDEF" = on ]; then echo "Forbidden (403)" >&2; exit 1; fi
        # Columns as verify-tenant asks: id, name, state, grants MFA, names the
        # sign-in group, sign-in frequency, names the administrators group.
        case "${AZ_STUB_CA:-none}" in
          sign-in-only) printf '%s\tContoso Example: require MFA\tenabled\tTrue\tTrue\t10\tFalse\n' "$(fake_id ca-policy)" ;;
          both) printf '%s\tContoso Example: require MFA\tenabled\tTrue\tTrue\t10\tTrue\n' "$(fake_id ca-policy)" ;;
          *) empty ;;
        esac ;;
      *"/groups/"*)
        gid="$(printf '%s' "$URL" | sed -e 's|.*/groups/||' -e 's|[/?].*||' | tr '[:upper:]' '[:lower:]')"
        f="${AZ_STUB_MEMBERS_DIR:-/nonexistent}/$gid"
        case "$URL" in
          *"/members/microsoft.graph.group"*)
            f=/nonexistent; nest="$(shape_line "$gid" nested)"
            case "$nest" in
              "") ;;
              fail) echo "Too Many Requests (429)" >&2; exit 1 ;;
              *) [ "$Q" = '"@odata.nextLink"' ] && exit 0
                 i=0; while [ "$i" -lt "$nest" ]; do fake_id "nested-$gid-$i"; i=$((i+1)); done; exit 0 ;;
            esac ;;
        esac
        if [ ! -f "$f" ]; then
          case "$Q" in length*) printf '0\n' ;; *) empty ;; esac
        else
          size="${AZ_STUB_PAGE_SIZE:-999}"; page=1
          case "$URL" in *"\$skiptoken="*) page="${URL##*\$skiptoken=}"; page="${page%%&*}" ;; esac
          total="$(grep -c . "$f" || true)"
          if [ "$Q" = '"@odata.nextLink"' ]; then
            if [ "${AZ_STUB_NEXTLINK_FAIL:-0}" = 1 ]; then echo "Too Many Requests (429)" >&2; exit 1; fi
            if [ $((page*size)) -lt "$total" ]; then
              printf '%s\n' "${URL%%\?*}?\$skiptoken=$((page+1))"
            fi
            exit 0
          fi
          rows="$(grep . "$f" | sed -n "$(( (page-1)*size + 1 )),$(( page*size ))p")"
          if printf '%s\n' "$rows" | grep -qx '!fail'; then echo "Forbidden (403)" >&2; exit 1; fi
          case "$Q" in *"userType=='Guest'"*) [ "${AZ_STUB_GUEST_READ_FAIL:-0}" = 1 ] && { echo "Too Many Requests (429)" >&2; exit 1; } ;; esac
          # preflight.sh --group counts every row itself: enabled, type, address.
          case "$Q" in
            "value[].[accountEnabled, userType"*)
              printf '%s\n' "$rows" | awk -F'\t' 'NF >= 3 { print $2 "\t" $3 "\t" $4 }'; exit 0 ;;
          esac
          sel="$(printf '%s\n' "$rows" | awk -F'\t' -v q="$Q" '
            NF < 3 { next }
            index(q, "accountEnabled") && $2 != "true" { next }
            index(q, "userType!=") && $3 == "Guest" { next }
            index(q, "userType==") && $3 != "Guest" { next }
            { print }')"
          case "$Q" in
            length*) printf '%s\n' "$sel" | grep -c . || true ;;
            *".[id, mail"*) printf '%s\n' "$sel" | awk -F'\t' 'NF { print $1 "\t" $4 "\t" $5 }' ;;
            *) printf '%s\n' "$sel" | awk -F'\t' 'NF { print $1 }' ;;
          esac
        fi ;;
      *) case "$Q" in length*) printf '0\n' ;; *) empty ;; esac ;;
    esac ;;
  *) empty ;;
esac
exit 0
