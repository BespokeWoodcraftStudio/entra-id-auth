# A filled site config for the scripts' plan-mode tests. Placeholders only:
# contoso.com addresses, an all-zero tenant id. run.sh replaces __SITE_DIR__
# with a throwaway copy of fixtures/fresh-site and appends each scenario's
# changes below (a later line wins when the file is sourced).
SITE=contoso-example
SITE_TITLE='Contoso Example'
APP_NAME='Contoso Example'
DOMAIN=portal.contoso.com
VERCEL_PROJECT=contoso-example
VERCEL_HOST=contoso-example.vercel.app
VERCEL_SCOPE=contoso-team
EMAIL_DOMAINS=contoso.com
SITE_DIR=__SITE_DIR__
TENANT_ID=00000000-0000-0000-0000-000000000000

GROUP_ID=
GROUP_NAME='Contoso Example'
GROUP_NICK=contoso-example
MEMBERS='alex@contoso.com,sam@contoso.com'
OWNERS='admin@contoso.com,owner@contoso.com'
FIRST_ADMIN=owner@contoso.com
FIRST_ADMIN_NAME='First Admin'
EXTRA_ADMINS=
ASSIGNMENT_MODE=group
ROLE_SOURCE=site
ADMIN_GROUP_ID=
ADMIN_GROUP_NAME='Contoso Example Administrators'
ALLOW_GUESTS=no
JOIN_MODE=listed

REQUIRE_MFA=yes
MFA_ANSWERED_BY='Test Owner, 2026-01-15'
SESSION_IDLE_MINUTES=45
SESSION_MAX_HOURS=10
SESSION_ANSWERED_BY='Test Owner, 2026-01-15'

PASSWORD_LANE=local+preview
PREVIEW_MODE=test-lane
PREVIEW_HOST=
DB_SOURCE=existing
RECORD_IN_REPO=no

LOCAL_PORT=3000
LOCAL_DATABASE_URL=
SECRET_MONTHS=11
ADOPT_EXISTING_APPS=no
HIDE_FROM_MY_APPS=no
NEEDS_M365_SERVER=no
MAILBOXES=
EXCHANGE_ROLE='Application Mail.Read'
